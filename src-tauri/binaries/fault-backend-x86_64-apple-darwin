#!/bin/bash
# Fault.ai Backend Sidecar Runner for macOS (Intel)
# This script starts the Python backend server for the Fault.ai application

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/../../backend" || exit 1

# Try venv python first, fall back to system python3
if [ -f ".venv/bin/python3" ]; then
    .venv/bin/python3 run_server.py
else
    python3 run_server.py
fi
